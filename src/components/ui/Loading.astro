---
// Loading Component
// Description: A classic animated loading indicator
// Props:
// - size: an integer denoting the size of the spinner

type Props = {
	size?: number
}

const { size = 10 } = Astro.props
---

<span role="status" class=`box-border inline-block size-${size}`>
	<span aria-hidden="true" class="relative left-1/2 top-1/2 block size-full">
		{
			Array.from({ length: 12 }, (_, index) => (
				<span
					class="rounded-(--radius) absolute left-[-10%] top-[-3.9%] block h-[8%] w-[24%] bg-current"
					style={{
						transform: `rotate(${index * 30}deg) translate(146%)`,
						animation: 'loading-ui-classic-fade var(--duration, 1.2s) linear infinite',
						animationDelay: `calc(var(--duration, 1.2s) / 12 * ${index - 12})`
					}}
				/>
			))
		}
	</span>
	<span class="sr-only">Loading</span>
</span>

<style>
	@keyframes loading-ui-classic-fade {
		0% {
			opacity: 1;
		}

		100% {
			opacity: 0.15;
		}
	}
</style>
