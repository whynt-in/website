---
// Blog post page with dynamic routing for
// individual posts from the content collection

// Post layout and content rendering
import Layout from '../../layouts/PostLayout.astro'

// Get all blog entries and render markdown
import { getCollection, render } from 'astro:content'

// Generate static paths for all blog posts
export async function getStaticPaths() {
	const blogEntries = await getCollection('blog')
	return blogEntries.map((entry) => ({
		params: { id: decodeURI(entry.id) },
		props: { entry }
	}))
}

// Get current post entry and render markdown
const { entry } = Astro.props
const { Content } = await render(entry)
---

<Layout frontmatter={entry.data}>
	<Content />
</Layout>
