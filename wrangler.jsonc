{
	"$schema": "node_modules/wrangler/config-schema.json",

	"name": "corporate-website",
	"main": "src/worker.ts",
	"compatibility_date": "2026-06-16",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"routes": ["whynt.in/*", "www.whynt.in/*"],

	// Enable smart placement
	"placement": {
		"mode": "smart"
	},

	// Enable observability
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},

	// Static assets binding
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},

	// Rate Limiter (D.O.) setup
	"durable_objects": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"class_name": "RateLimiter"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["RateLimiter"]
		}
	],

	// Cloudflare D1 SQL Database
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "whynt_corporate_prod",
			"database_id": "f52e1692-28fb-44fe-a605-3a51d1f78656"
		}
	],

	// Environment variables
	"vars": {
		"PUBLIC_GA_TRACKING_ID": "G-VZ7P3NDLLY"
	}
}
