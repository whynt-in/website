---
// Basic Contact Form
// ------------
// Description: A basic contact form with fields for first name, last name, email, phone number and message.
// Properties:
// - classes: Additional classes to be added to the block
// ------------

// Components
// - UI
import Card from '../../ui/cards/partials/Card.astro'
import CardBody from '../../ui/cards/partials/CardBody.astro'
import Form from '../../ui/forms/Form.astro'
import FormField from '../../ui/forms/partials/FormField.astro'
import InputField from '../../ui/forms/form-elements/InputField.astro'
import TextArea from '../../ui/forms/form-elements/TextArea.astro'
import Button from '../../ui/Button.astro'

// Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Card classes={classes}>
	<CardBody>
		<Form id="contactForm">
			<h2 class="text-2xl">Fill in the form below to continue.</h2>
			<FormField>
				<InputField type="text" id="firstName" label="First Name" required />
				<InputField type="text" id="lastName" label="Last Name" required />
			</FormField>
			<FormField>
				<InputField type="email" id="email" label="Email" required />
			</FormField>
			<FormField>
				<InputField type="tel" id="phone" label="Phone Number" />
			</FormField>
			<FormField><TextArea id="message" label="Type your message here ..." required /></FormField>
			<Button style="primary" type="submit">Submit</Button>
		</Form>
	</CardBody>
</Card>

<script>
	type ContactApiResponse = {
		success: boolean
		message: string
		error: string
	}

	const form = document.getElementById('contactForm') as HTMLFormElement | null

	if (form) {
		form.addEventListener('submit', (event) => {
			event.preventDefault()

			const modal = document.getElementById('accessory-modal')
			if (!modal) {
				console.error('Modal element not found')
				return
			}
			modal.classList.add('open')

			const formData = new FormData(form)
			const data = Object.fromEntries(formData.entries())

			setTimeout(() => {
				fetch('/api/v1/contact', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json'
					},
					body: JSON.stringify(data)
				})
					.then((response) => response.json() as Promise<ContactApiResponse>)
					.then((result) => {
						const loaderElement = document.querySelector('div.modal__loader')
						if (loaderElement) {
							loaderElement.remove()
						}

						const titleElement = document.querySelector('h2.modal__title')
						if (titleElement) {
							titleElement.textContent = result.message || result.error
						}

						const innerTextElement = document.querySelector('div.modal__inner_text')
						if (innerTextElement) {
							if (result.success) {
								innerTextElement.textContent =
									'Thank you for contacting Whynt. We will get back to you as soon as possible.'
							} else {
								innerTextElement.textContent = 'Oops! Something went wrong. Please try again later.'
							}
						}

						const buttonElement = document.querySelector('div.modal__inner_button')
						if (buttonElement) {
							buttonElement.classList.remove('hidden')
						}
					})
					.catch((error) => {
						// TODO: Handle non-server error state in the modal
						console.error('Error:', error)
					})
			}, 1000)
		})
	}
</script>
