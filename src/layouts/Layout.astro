---
// Base layout for all pages with global structure,
// styling, fonts, and analytics integration

// UI Components
import NavigationBar from '../components/ui/NavigationBar.astro'
import Main from '../components/ui/Main.astro'
import Footer from '../components/ui/Footer.astro'
import Header from '../components/blocks/head/Header.astro'
// Form feedback modal displayed on contact form success/error
import FormSubmissionModal from '../components/blocks/modal/FormSubmissionModal.astro'
// Analytics and third-party scripts
import Scriprs from '../components/scripts/LocalScripts.astro'
// Styles
import '../styles/global.css'
// Fonts
import '@fontsource-variable/inter'
import '@fontsource-variable/outfit'
// Data
import { configData } from '../config/config'

// Props
type Props = {
	title?: string
	description?: string
	ogImage?: string
	noindex?: boolean
	classes?: string
}
// Page Metadata
const { title, description, ogImage, noindex, classes } = Astro.props
---

<!doctype html>
<html lang="en" class="scroll-animation mode-auto relative">
	<Header title={title} description={description} ogImage={ogImage} noindex={noindex} />
	<body
		class:list={[
			{ ['mode-' + `${configData.mode}`]: configData.mode },
			{ ['scroll-animation']: configData.scrollAnimations },
			{ [`${classes}`]: classes }
		]}
	>
		<NavigationBar />
		<Main>
			<slot />
		</Main>
		<Footer />
		<FormSubmissionModal id="accessory-modal" />
		<Scriprs />
	</body>
</html>
