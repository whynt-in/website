---
// Contact page with form, company info,
// social proof, and call-to-action section

// Page layout and content blocks
import Layout from '../layouts/Layout.astro'
// Hero, form, contact info, testimonials, CTA
import FormHero from '../components/blocks/hero/ContactHero.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'
import ContactCards from '../components/blocks/contact/ContactCards.astro'
import SocialProof from '../components/blocks/socialproof/Basic.astro'

// Contact page SEO and hero section data
const SEO = {
	title: 'Whynt | Contact Us',
	description:
		'Contact Whynt to discuss a custom software project, website build, digital marketing campaign, maintenance support, or integration work for your business.',
	noindex: false
}
// Hero section title and description
const header = {
	title: 'Let’s get in <strong>touch</strong>.',
	text: "Whether you have a question, need support, or just want to share your feedback, we're all ears. Reach out to us and we'll get back to you as soon as possible."
}
---

<Layout title={SEO.title} description={SEO.description} noindex={SEO.noindex}>
	<FormHero
		title={header.title}
		text={header.text}
		id="contact"
		classes="bg-neutral-50 dark:bg-neutral-950/80"
	/>
	<ContactCards classes="dark:bg-neutral-950/80" />
	<SocialProof classes="dark:bg-neutral-950/80" />
	<CTA />
</Layout>
