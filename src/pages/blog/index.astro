---
// Blog listing page with all published posts
// sorted and filtered with navigation

// Page layout and content components
import Layout from '../../layouts/Layout.astro'
// Hero and blog post list renderer
import Hero from '../../components/blocks/hero/PageHeader.astro'
import BlogPosts from '../../components/blocks/blog/BlogPosts.astro'

// Fetch all blog posts from content collection
import { getCollection } from 'astro:content'

// Blog page SEO and hero section data
const SEO = {
	title: 'Whynt | Blog',
	description:
		'Read Whynt’s latest updates, practical insights, and project notes on software, websites, digital marketing, maintenance, and integrations.'
}
// Hero section title and description
const header = {
	title: 'The <strong>Whynt</strong> Blog. Tips, Updates & Stories',
	text: 'Stay informed, stay productive. All the latest from the world of Whynt.'
}

// Retrieve all published blog posts
const allPosts = await getCollection('blog')
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<BlogPosts data={allPosts} />
</Layout>
