---
// Basic Contact Form
// ------------
// Description: A basic contact form with fields for first name, last name, email, phone number and message.
// Properties:
// - classes: Additional classes to be added to the block
// ------------

// Components
// - UI
import Card from '../../ui/cards/partials/Card.astro'
import CardBody from '../../ui/cards/partials/CardBody.astro'
import Form from '../../ui/forms/Form.astro'
import FormField from '../../ui/forms/partials/FormField.astro'
import InputField from '../../ui/forms/form-elements/InputField.astro'
import TextArea from '../../ui/forms/form-elements/TextArea.astro'
import Button from '../../ui/Button.astro'

// Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Card classes={classes}>
	<CardBody>
		<Form id="contactForm">
			<h2 class="text-2xl">Fill in the form below to continue.</h2>
			<FormField>
				<InputField type="text" id="firstName" label="First Name" required />
				<InputField type="text" id="lastName" label="Last Name" required />
			</FormField>
			<FormField>
				<InputField type="email" id="email" label="Email" required />
			</FormField>
			<FormField>
				<InputField type="tel" id="phone" label="Phone Number" />
			</FormField>
			<FormField
				><TextArea
					id="message"
					label="Type your message here ..."
					required
					maxLength={1024}
					helperText="Remaining: 1024/1024 characters"
				/></FormField
			>
			<div class="flex flex-col gap-4">
				<div id="turnstile-container" class="max-w-full overflow-scroll"></div>
				<Button style="primary" size="lg" type="submit" disabled>
					<span class="text-lg">Submit</span>
				</Button>
			</div>
		</Form>
	</CardBody>
</Card>

<script>
	import { initiateTurnstile, turnstileState } from './_helpers/cf_turnstile'
	import { updateSubmitButtonState } from './_helpers/submit_button'
	import { addContactFormSubmitListener } from './_helpers/form_submit_handler'

	initiateTurnstile()
	addContactFormSubmitListener(turnstileState)

	const form = document.querySelector('form')
	form?.addEventListener('input', () => {
		updateSubmitButtonState(turnstileState.isCAPTCHAValidated)
	})
	form?.addEventListener('change', () => {
		updateSubmitButtonState(turnstileState.isCAPTCHAValidated)
	})

	document.getElementById('message')?.addEventListener('input', (event) => {
		const target = event.target as HTMLTextAreaElement
		const charCount = target.value.length

		// Target input sanitation to @everyone / @here mentions
		target.value = target.value
			.replace(/@everyone/g, '@\u200beveryone')
			.replace(/@here/g, '@\u200bhere')

		const helperText = target.parentElement?.querySelector(
			'small.input__helper-text'
		) as HTMLElement | null
		if (helperText) {
			helperText.textContent = `Remaining: ${1024 - charCount}/1024 characters`
		}
	})
</script>
