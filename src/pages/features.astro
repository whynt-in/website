---
// Features page with categorized capabilities
// across analytics, productivity, security, etc.

// Page layout and feature sections
import Layout from '../layouts/Layout.astro'
// Feature showcase and CTA
import Feature from '../components/blocks/features/FeatureSticky.astro'
import Hero from '../components/blocks/hero/PageHeader.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'

// Load and categorize features from data file
import featuresData from '../data/json-files/featuresData.json'
// Group features by category for display
const featuresAnalytics = featuresData.filter((feature) => feature.category === 'Analytics')
const featuresProductivity = featuresData.filter((feature) => feature.category === 'Productivity')
const featuresSecurity = featuresData.filter((feature) => feature.category === 'Security')
const featuresIntegrations = featuresData.filter((feature) => feature.category === 'Integrations')
const featuresSupport = featuresData.filter((feature) => feature.category === 'Support')
const featuresMarketing = featuresData.filter((feature) => feature.category === 'Marketing')

// Features page SEO metadata
const SEO = {
	title: 'Whynt | Services and Capabilities',
	description:
		'Explore Whynt’s core capabilities across custom software development, website development, digital marketing, maintenance, integrations, and support.',
	noindex: false
}
// Features hero section title and description
const header = {
	title: 'Why you will <strong>love</strong> whynt.',
	text: 'Streamline your tasks, protect your data, and enjoy working with our tools!'
}
---

<Layout title={SEO.title} description={SEO.description} noindex={SEO.noindex}>
	<Hero title={header.title} text={header.text} />
	<Feature
		title="Actionable Insights"
		text="Gain clear visibility into your systems and data to make informed business decisions."
		data={featuresAnalytics}
	/>

	<Feature
		title="Operational Efficiency"
		text="Streamline workflows and reduce manual effort with systems built for real-world operations."
		data={featuresProductivity}
		classes="bg-neutral-50 dark:bg-neutral-900"
	/>

	<Feature
		title="Built-in Security"
		text="Protect your systems with secure architectures and structured access control."
		data={featuresSecurity}
	/>

	<Feature
		title="Seamless Integrations"
		text="Connect your tools, platforms, and workflows into one unified system."
		data={featuresIntegrations}
		classes="bg-neutral-50 dark:bg-neutral-900"
	/>

	<Feature
		title="Ongoing Support"
		text="Continuous maintenance and improvements to keep your systems running reliably."
		data={featuresSupport}
	/>
	<Feature
		title="Digital Marketing & Growth"
		text="Drive traffic and conversions with SEO, content, and paid acquisition tailored for SMBs."
		data={featuresMarketing}
		classes="bg-neutral-50 dark:bg-neutral-900"
	/>
	<CTA />
</Layout>
