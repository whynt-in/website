---
// Basic Cards grid Section
// ------------
// Description: A grid of cards with basic contact information in a 4 column layout.
// Properties:
// - classes: Additional classes to be added to the Section

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/BasicCard.astro'

// 	Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section id="requests" classes={classes}>
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-balance">Have a Special Request? We’re Here to <strong>Help</strong>!</h2>
			<p class="pb-0 text-justify text-lg md:text-center">
				Choose an option below to get the help you need. Whether it’s support, sales inquiries,
				project discussions, or general questions, our team is here to provide clear guidance and
				reliable assistance.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="3">
			<Card
				title="Support"
				subtitle="Need help with your systems or facing issues? Reach out and we’ll help you resolve them quickly and efficiently."
				icon="rocket"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contact"
			/>
		</Col>

		<Col span="3">
			<Card
				title="Sales"
				subtitle="Looking to build or scale your systems? Talk to us about plans or custom solutions tailored to your business."
				icon="document-text"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contact"
			/>
		</Col>

		<Col span="3">
			<Card
				title="Project Requests"
				subtitle="Have a system or idea in mind? Share your requirements and we’ll help you plan and build it."
				icon="bolt"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contact"
			/>
		</Col>

		<Col span="3" classes="flex flex-col gap-6">
			<Card
				title="Feedback"
				subtitle="Share your thoughts on our work, systems, or process. We use your feedback to improve continuously."
				icon="chat-bubble-left-ellipsis"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contact"
			/>
		</Col>
	</Row>
</Section>
