---
// Basic Dark Call To Action section
// ------------
// Description: A centered call to action section that contains: a title, text, background image, notification and a button.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import CTA from '../../ui/CTA.astro'
import Button from '../../ui/Button.astro'
import ChipNotification from '../../ui/ChipNotification.astro'
import Highlight from '../../ui/Highlight.astro'

// Content
import ctaImage from '../../../assets/cta-dark-bg.webp'
import badge from '../../../assets/badge.svg'
---

<Section>
	<Row>
		<Col span="1" />
		<Col span="10">
			<CTA
				title="Built for teams that ship faster"
				text="Whynt helps businesses design, build, and maintain software systems that streamline operations and improve productivity. Start building better workflows today."
				mode="dark"
				bg={ctaImage}
			>
				<ChipNotification radius="rounded-full" classes="mb-6 box">
					<img src={badge.src} alt="Trusted Systems" class="h-12 w-12" slot="button" />
					<span class="text-justify">Trusted by <Highlight>30+</Highlight> growing businesses</span>
				</ChipNotification>
				<Button size="lg" style="primary" link="/contact">Get started now!</Button>
			</CTA>
		</Col>
		<Col span="1" />
	</Row>
</Section>
