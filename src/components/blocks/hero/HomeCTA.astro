---
// Home page CTA Section
// ------------
// Description: A centered call to action section that contains: a title, text, a user review snippet, a button and a image.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import ChipNotification from '../../ui/ChipNotification.astro'
import Button from '../../ui/Button.astro'
import AvatarGroup from '../../ui/AvatarGroup.astro'

// Content
// - Hero Image
import heroImage from '../../../assets/hero-01.webp'
import { Picture } from 'astro:assets'
// - Tools
import tool1 from '../../../assets/tools/astro-icon.webp'
import tool2 from '../../../assets/tools/gitlab-logomark.webp'
import tool3 from '../../../assets/tools/cloudflare-press-kit.webp'
const tools = [
	{ image: { src: tool1.src, alt: 'Astro' }, link: 'https://astro.build/' },
	{ image: { src: tool2.src, alt: 'GitLab' }, link: 'https://gitlab.com/' },
	{ image: { src: tool3.src, alt: 'Cloudflare' }, link: 'https://cloudflare.com/' }
]
---

<Section id="intro" padding="top" classes="bg-neutral-50 dark:bg-neutral-900">
	<Row>
		<Col span="2" />
		<Col span="8" align="center">
			<ChipNotification radius="rounded-full" classes="mb-6">
				<strong>200+</strong> supported tools.
				<AvatarGroup avatars={tools} radius="rounded-full" slot="button" />
			</ChipNotification>
			<h1>Modern softwares for <strong>modern</strong> businesses.</h1>

			<p class="pb-0 text-lg">Built, maintained, and scaled for your business by Whynt.</p>
			<Button size="lg" link="/contact">Get a free consultation</Button>
		</Col>
		<Col span="2" />
		<Col span="2" />
		<Col span="8">
			<Picture
				priority
				quality={100}
				src={heroImage}
				alt="Whynt Example software image."
				class="translate-y-8 shadow-2xl shadow-neutral-200 dark:shadow-neutral-950"
				width={heroImage.width}
				height={heroImage.height}
			/></Col
		>
		<Col span="2" />
	</Row>
</Section>
