---
// Feature Cards grid Section
// ------------
// Description: A grid of cards with feature information in a 4 column layout.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/FeatureCard.astro'

// Content
// - Cards
import feature01 from '../../../assets/cards/feature-01.svg'
import feature02 from '../../../assets/cards/feature-02.svg'
import feature03 from '../../../assets/cards/feature-03.svg'
import feature04 from '../../../assets/cards/feature-04.svg'
import feature05 from '../../../assets/cards/feature-05.svg'
---

<Section id="features">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">Software that <strong>powers</strong> your business.</h2>
			<p class="pb-0 text-justify text-lg md:text-center">
				We design and build tailored systems that streamline operations, improve productivity, and
				support growth. Whynt adapts to your workflow and scales as your business evolves.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="4">
			<Card
				title="Unified systems that work together"
				subtitle="We connect your tools, data, and workflows into a single coherent system that reduces fragmentation and improves control."
				image={feature01}
				link="/features"
			/>
		</Col>

		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Built around your workflow"
				subtitle="Every system is designed to match how your business actually operates, reducing friction and improving day-to-day efficiency."
				image={feature02}
				link="/features"
			/>
			<Card
				title="Real-time collaboration"
				subtitle="Enable teams to communicate, share updates, and work together seamlessly across departments and functions."
				image={feature03}
				link="/features"
			/>
		</Col>

		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Scalable customer management"
				subtitle="Track, organize, and manage customer relationships with systems that grow as your user base expands."
				image={feature04}
				link="/features"
			/>
			<Card
				title="Automated operations"
				subtitle="Reduce manual work with automation across billing, reporting, and routine business processes."
				image={feature05}
				link="/features"
			/>
		</Col>
	</Row>
</Section>
