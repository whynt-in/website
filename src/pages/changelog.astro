---
// Changelog page displaying product updates
// and improvements over time

// Page layout and feed components
import Layout from '../layouts/Layout.astro'
// Hero, update feed, and CTA
import Hero from '../components/blocks/hero/PageHeader.astro'
import SimpleFeed from '../components/blocks/feeds/BasicFeed.astro'
import CTA from '../components/blocks/CTA/BasicLight.astro'

// Load changelog entries from data file
import feedData from '../data/json-files/changelogData.json'

// Changelog page SEO metadata
const SEO = {
	title: 'Whynt | Updates and Improvements',
	description:
		'Explore the latest Whynt updates, refinements, and improvements across software builds, websites, maintenance, and integrations.'
}
// Changelog hero section title and description
const header = {
	title: 'Whynt <strong>Changelog</strong>',
	text: 'Stay informed about all the new updates and improvements in Whynt.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<SimpleFeed data={feedData} />
	<CTA />
</Layout>
