---
// Blog tags landing page listing all
// available tags and their post counts

// Page layout and blog components
import Layout from '../../../layouts/Layout.astro'
// Hero and blog post display
import Hero from '../../../components/blocks/hero/PageHeader.astro'
import BlogPosts from '../../../components/blocks/blog/BlogPosts.astro'

// Fetch all blog posts for tag listing
import { getCollection } from 'astro:content'
const allPosts = await getCollection('blog')
---

<Layout>
	<Hero title="Tags" />
	<BlogPosts data={allPosts} />
</Layout>
