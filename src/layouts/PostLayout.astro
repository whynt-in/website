---
// Blog post wrapper layout with post-specific
// header, metadata, and inherited base styling
const { frontmatter } = Astro.props

// Reuse base layout for consistent styling
import Layout from './Layout.astro'

// Blog hero section with title and metadata
import BlogPostHero from '../components/blocks/blog/BlogPostHero.astro'

// Build SEO metadata from post frontmatter
const SEO = {
	title: `${frontmatter.title} | Whynt`,
	description: `${frontmatter.description}`,
	noindex: false
}
---

<Layout title={SEO.title} description={SEO.description} noindex={SEO.noindex}>
	<BlogPostHero
		tags={frontmatter.tags}
		title={frontmatter.title}
		author={frontmatter.author}
		publishDate={frontmatter.pubDate.toLocaleDateString('en-US', {
			year: 'numeric',
			month: 'long',
			day: 'numeric'
		})}
	/>

	<div class="post-body basic-text basic-text--lg">
		<slot />
	</div>
</Layout>

<style>
	.post-body {
		@apply mx-auto max-w-3xl px-6 py-12 lg:py-24;
	}
</style>
