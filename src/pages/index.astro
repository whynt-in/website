---
// Homepage with hero, features, testimonials,
// highlights, and CTA sections

// Page layout and section components
import Layout from '../layouts/Layout.astro'
// Hero, features, social proof, highlights, CTA
import Hero from '../components/blocks/hero/HomeCTA.astro'
import Features from '../components/blocks/features/FeatureCards.astro'
import Testimonial from '../components/blocks/testimonials/BasicDark.astro'
import HighlightBlocks from '../components/blocks/highlights/HightlightRows.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'

// Homepage background image asset
import testimonialBackground from '../assets/testimonial-bg-01.webp'

// SEO metadata for homepage
const SEO = {
	title: 'Whynt | Software That Grows With Your Business',
	description:
		'Whynt builds practical software, modern websites, and long-term support for small and mid-sized businesses that need reliable tech execution.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero />
	<Features />
	<Testimonial bg={testimonialBackground} bgPosition="right" />
	<HighlightBlocks />
	<CTA />
</Layout>
