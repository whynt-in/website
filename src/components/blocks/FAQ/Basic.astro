---
// Basic FAQ section
// ------------
// Description: A section that contains a list of frequently asked questions with answers.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Accordion from '../../ui/Accordion.astro'
import Card from '../../ui/cards/partials/Card.astro'

// Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section id="FAQ" classes={classes}>
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">
				Frequently Asked <strong>Questions</strong>.
			</h2>
			<p class="text-lg leading-relaxed">
				Curious about our pricing plans? We’re always here to help.
			</p>
		</Col>
		<Col span="2" />
		<Col span="8">
			<Card classes="divide-y divide-neutral-100 dark:divide-neutral-800">
				<Accordion
					title="What is included in the free trial?"
					text="Our free trial gives you access to core features so you can evaluate how our systems fit your business needs. For full access or custom setups, contact our team."
				/>
				<Accordion
					title="Can I change my plan later?"
					text="Yes, you can upgrade or adjust your plan at any time. Simply contact our team and we will handle the transition for you."
				/>
				<Accordion
					title="Are there any hidden fees?"
					text="No, we maintain transparent pricing. For custom requirements or additional work, all costs are clearly discussed upfront."
				/>
				<Accordion
					title="What payment methods do you accept?"
					text="We support standard payment methods like Bank Transfer (IMPS / NEFT / RTGS), Credit / Debit Cards (Visa, Mastercard, Amex, RuPay), UPI (for Indian customers only), and Wire Transfer (SWIFT). For billing details, invoicing, or custom arrangements, please contact our team."
				/>
				<Accordion
					title="Do you offer discounts for annual plans?"
					text="Yes, we offer discounted pricing for long-term engagements. Contact us to discuss the best option for your business."
				/>
			</Card>
		</Col>
		<Col span="2" />
	</Row>
</Section>

<style>
	.page-header {
		@apply mx-auto max-w-3xl;
	}
	.page-header__text {
		@apply text-lg leading-relaxed;
	}
</style>
